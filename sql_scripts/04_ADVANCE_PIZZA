-- Analyze the cumulative revenue generated over time.
-- Uses a Window Function (SUM() OVER) to track growth across dates.
WITH CTE AS 
(
SELECT 
       DATE,
       SUM(PRICE*QUANTITY) AS TTL
FROM ORDERS AS O JOIN order_details AS OD
USING(ORDER_ID) JOIN pizzas AS P
USING(pizza_id)
GROUP BY 1
)
SELECT 
       DATE,
       TTL,
       SUM(TTL) OVER(ORDER BY DATE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CUM_REVENUE
FROM CTE;

