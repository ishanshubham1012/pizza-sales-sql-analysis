-- Calculate the percentage contribution of each pizza CATEGORY to total revenue.

WITH CTE AS (
SELECT 
       CATEGORY,
       SUM(PRICE*QUANTITY) AS TTL
FROM pizzas AS P JOIN pizza_types AS PT
USING(pizza_type_id) JOIN order_details AS O
USING(pizza_id)
GROUP BY 1
)
SELECT 
       CATEGORY,
       TTL,
       ROUND((TTL/(SELECT SUM(TTL) FROM CTE))*100,2) AS CONTRI
FROM CTE;

