-- Determine the top 3 most ordered pizza types based on revenue for each pizza category.
-- Uses PARTITION BY to calculate independent rankings for every pizza group.
WITH CTE AS 
(
SELECT 
       CATEGORY,
       NAME,
       SUM(PRICE*QUANTITY) AS TTL1,
       DENSE_RANK() OVER(PARTITION BY CATEGORY ORDER BY SUM(PRICE*QUANTITY) DESC) AS RNK
FROM pizzas AS P JOIN pizza_types AS PT
USING(pizza_type_id) JOIN order_details AS O
USING(pizza_id)
GROUP BY 1,2
)
SELECT 
       CATEGORY,
       NAME,
       TTL1
FROM CTE
WHERE RNK < 4;
